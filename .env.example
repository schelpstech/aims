APP_NAME="AIMS Nigeria"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/aims/public
APP_TIMEZONE=Africa/Lagos

LOG_LEVEL=debug
LOG_PATH=storage/logs/application.log

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=aims_session
SESSION_LIFETIME=120
SESSION_SAVE_PATH=storage/sessions
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=4096
AUTH_REGISTRATION_IDENTITY_ATTEMPTS=3
AUTH_REGISTRATION_IP_ATTEMPTS=20
AUTH_REGISTRATION_DECAY_MINUTES=60
AUTH_RESET_IDENTITY_ATTEMPTS=3
AUTH_RESET_IP_ATTEMPTS=20
AUTH_RESET_DECAY_MINUTES=60
AUTH_VERIFICATION_TTL_MINUTES=1440
AUTH_RESET_TTL_MINUTES=60
AUTH_LOGIN_IDENTITY_ATTEMPTS=5
AUTH_LOGIN_IP_ATTEMPTS=50
AUTH_LOGIN_DECAY_MINUTES=15
AUTH_LOGIN_LOCK_MINUTES=15

MAIL_ENABLED=false
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AIMS Nigeria"
NOTIFICATION_MAX_ATTEMPTS=5

MEMBERSHIP_DOCUMENT_PATH=storage/private/membership-documents
MEMBERSHIP_DOCUMENT_MAX_BYTES=5242880
MEMBERSHIP_NUMBER_PREFIX=AIMS
PROGRAMME_ENROLMENT_PREFIX=AIMS-PRG

# Keep disabled until an approved provider adapter and HTTPS callback are configured.
PAYMENT_GATEWAY=disabled
PAYMENT_CALLBACK_URL=

CERTIFICATE_NUMBER_PREFIX=AIMS-CERT
CERTIFICATE_SIGNING_KEY=
CERTIFICATE_VERIFICATION_URL=

CMS_MEDIA_PATH=storage/private/cms-media
CMS_MAX_UPLOAD_BYTES=10485760
